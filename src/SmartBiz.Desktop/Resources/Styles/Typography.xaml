<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- ============================================== -->
    <!-- FONT FAMILIES                                  -->
    <!-- ============================================== -->
    <x:String x:Key="FontFamilyRegular">OpenSansRegular</x:String>
    <x:String x:Key="FontFamilySemibold">OpenSansSemibold</x:String>
    <x:String x:Key="FontFamilyMono">Consolas</x:String>

    <!-- ============================================== -->
    <!-- FONT SIZES                                     -->
    <!-- ============================================== -->
    <x:Double x:Key="FontSizeXs">11</x:Double>
    <x:Double x:Key="FontSizeSm">12</x:Double>
    <x:Double x:Key="FontSizeBase">14</x:Double>
    <x:Double x:Key="FontSizeMd">16</x:Double>
    <x:Double x:Key="FontSizeLg">18</x:Double>
    <x:Double x:Key="FontSizeXl">22</x:Double>
    <x:Double x:Key="FontSize2Xl">28</x:Double>
    <x:Double x:Key="FontSize3Xl">36</x:Double>

    <!-- ============================================== -->
    <!-- TYPOGRAPHY STYLES                              -->
    <!-- ============================================== -->

    <!-- Page title (H1) -->
    <Style x:Key="Heading1" TargetType="Label">
        <Setter Property="FontFamily" Value="{StaticResource FontFamilySemibold}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize2Xl}" />
        <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
    </Style>

    <!-- Section title (H2) -->
    <Style x:Key="Heading2" TargetType="Label">
        <Setter Property="FontFamily" Value="{StaticResource FontFamilySemibold}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeXl}" />
        <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
    </Style>

    <!-- Card title (H3) -->
    <Style x:Key="Heading3" TargetType="Label">
        <Setter Property="FontFamily" Value="{StaticResource FontFamilySemibold}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeLg}" />
        <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
    </Style>

    <!-- Form labels -->
    <Style x:Key="FormLabel" TargetType="Label">
        <Setter Property="FontFamily" Value="{StaticResource FontFamilySemibold}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeSm}" />
        <Setter Property="TextColor" Value="{StaticResource TextSecondary}" />
        <Setter Property="Margin" Value="0,0,0,6" />
    </Style>

    <!-- Body text -->
    <Style x:Key="BodyText" TargetType="Label">
        <Setter Property="FontFamily" Value="{StaticResource FontFamilyRegular}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBase}" />
        <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
    </Style>

    <!-- Secondary body text -->
    <Style x:Key="BodyTextSecondary" TargetType="Label">
        <Setter Property="FontFamily" Value="{StaticResource FontFamilyRegular}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBase}" />
        <Setter Property="TextColor" Value="{StaticResource TextSecondary}" />
    </Style>

    <!-- Small caption -->
    <Style x:Key="Caption" TargetType="Label">
        <Setter Property="FontFamily" Value="{StaticResource FontFamilyRegular}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeSm}" />
        <Setter Property="TextColor" Value="{StaticResource TextSecondary}" />
    </Style>

    <!-- Tiny meta info -->
    <Style x:Key="MetaText" TargetType="Label">
        <Setter Property="FontFamily" Value="{StaticResource FontFamilyRegular}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeXs}" />
        <Setter Property="TextColor" Value="{StaticResource TextTertiary}" />
    </Style>

</ResourceDictionary>