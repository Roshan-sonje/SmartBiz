<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- ============================================== -->
    <!-- BORDER RADIUS                                  -->
    <!-- ============================================== -->
    <x:Double x:Key="RadiusNone">0</x:Double>
    <x:Double x:Key="RadiusSm">4</x:Double>
    <x:Double x:Key="RadiusMd">6</x:Double>
    <x:Double x:Key="RadiusLg">8</x:Double>
    <x:Double x:Key="RadiusXl">12</x:Double>
    <x:Double x:Key="RadiusFull">9999</x:Double>

    <!-- ============================================== -->
    <!-- CONTROL HEIGHTS                                -->
    <!-- ============================================== -->
    <x:Double x:Key="ControlHeightSm">32</x:Double>
    <x:Double x:Key="ControlHeightMd">40</x:Double>
    <x:Double x:Key="ControlHeightLg">48</x:Double>

    <!-- ============================================== -->
    <!-- BORDER WIDTHS                                  -->
    <!-- ============================================== -->
    <x:Double x:Key="BorderThin">1</x:Double>
    <x:Double x:Key="BorderThick">2</x:Double>

    <!-- ============================================== -->
    <!-- LAYOUT                                         -->
    <!-- ============================================== -->
    <x:Double x:Key="SidebarWidth">240</x:Double>
    <x:Double x:Key="HeaderHeight">64</x:Double>
    <x:Double x:Key="IconSizeSm">16</x:Double>
    <x:Double x:Key="IconSizeMd">20</x:Double>
    <x:Double x:Key="IconSizeLg">24</x:Double>

</ResourceDictionary>