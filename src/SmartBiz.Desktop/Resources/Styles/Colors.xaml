<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- ============================================== -->
    <!-- BRAND                                          -->
    <!-- ============================================== -->
    <Color x:Key="BrandPrimary">#1E3A8A</Color>
    <Color x:Key="BrandPrimaryDark">#1E40AF</Color>
    <Color x:Key="BrandPrimaryLight">#3B82F6</Color>
    <Color x:Key="BrandAccent">#0D9488</Color>
    <Color x:Key="BrandAccentDark">#0F766E</Color>
    <Color x:Key="BrandAccentLight">#14B8A6</Color>

    <!-- ============================================== -->
    <!-- BACKGROUND & SURFACE                           -->
    <!-- ============================================== -->
    <Color x:Key="BackgroundPrimary">#F9FAFB</Color>
    <Color x:Key="BackgroundSecondary">#F3F4F6</Color>
    <Color x:Key="SurfacePrimary">#FFFFFF</Color>
    <Color x:Key="SurfaceSecondary">#F9FAFB</Color>
    <Color x:Key="SurfaceElevated">#FFFFFF</Color>

    <!-- ============================================== -->
    <!-- TEXT                                           -->
    <!-- ============================================== -->
    <Color x:Key="TextPrimary">#111827</Color>
    <Color x:Key="TextSecondary">#6B7280</Color>
    <Color x:Key="TextTertiary">#9CA3AF</Color>
    <Color x:Key="TextInverse">#FFFFFF</Color>
    <Color x:Key="TextDisabled">#D1D5DB</Color>

    <!-- ============================================== -->
    <!-- BORDER & DIVIDER                               -->
    <!-- ============================================== -->
    <Color x:Key="BorderDefault">#E5E7EB</Color>
    <Color x:Key="BorderStrong">#D1D5DB</Color>
    <Color x:Key="BorderFocus">#3B82F6</Color>

    <!-- ============================================== -->
    <!-- STATUS                                         -->
    <!-- ============================================== -->
    <Color x:Key="Success">#059669</Color>
    <Color x:Key="SuccessLight">#D1FAE5</Color>
    <Color x:Key="Warning">#D97706</Color>
    <Color x:Key="WarningLight">#FEF3C7</Color>
    <Color x:Key="Danger">#DC2626</Color>
    <Color x:Key="DangerLight">#FEE2E2</Color>
    <Color x:Key="Info">#2563EB</Color>
    <Color x:Key="InfoLight">#DBEAFE</Color>
    <Color x:Key="Neutral">#6B7280</Color>
    <Color x:Key="NeutralLight">#F3F4F6</Color>

    <!-- ============================================== -->
    <!-- SIDEBAR (dark navigation)                      -->
    <!-- ============================================== -->
    <Color x:Key="SidebarBackground">#1F2937</Color>
    <Color x:Key="SidebarBackgroundHover">#374151</Color>
    <Color x:Key="SidebarBackgroundActive">#0D9488</Color>
    <Color x:Key="SidebarText">#D1D5DB</Color>
    <Color x:Key="SidebarTextActive">#FFFFFF</Color>
    <Color x:Key="SidebarTextMuted">#9CA3AF</Color>

    <!-- ============================================== -->
    <!-- HEADER                                         -->
    <!-- ============================================== -->
    <Color x:Key="HeaderBackground">#FFFFFF</Color>
    <Color x:Key="HeaderBorder">#E5E7EB</Color>

    <!-- ============================================== -->
    <!-- SHADOWS & OVERLAY                              -->
    <!-- ============================================== -->
    <Color x:Key="OverlayBackground">#80000000</Color>
    <Color x:Key="ShadowSoft">#0A000000</Color>
    <Color x:Key="ShadowMedium">#1A000000</Color>
    <Color x:Key="ShadowStrong">#33000000</Color>

</ResourceDictionary>