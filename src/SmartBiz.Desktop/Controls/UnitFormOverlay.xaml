<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="SmartBiz.Desktop.Controls.UnitFormOverlay"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:SmartBiz.Desktop.Controls"
    IsVisible="False"
    BackgroundColor="#80000000">
    <Grid>
        <controls:SmartCard Padding="32" WidthRequest="500" HorizontalOptions="Center" VerticalOptions="Center">
            <Grid RowDefinitions="Auto,*,Auto" RowSpacing="16">
                <Label Text="Add Unit" FontSize="22" FontFamily="OpenSansSemibold" TextColor="{StaticResource TextPrimary}" />
                <VerticalStackLayout Grid.Row="1" Spacing="16">
                    <controls:SmartTextBox x:Name="NameField" Label="Name *" Placeholder="Kilogram" />
                    <controls:SmartTextBox x:Name="ShortNameField" Label="Short name *" Placeholder="kg" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <Label Grid.Column="0" Text="Allow decimal quantities" FontSize="14" VerticalOptions="Center" TextColor="{StaticResource TextPrimary}" />
                        <Switch x:Name="AllowDecimalSwitch" Grid.Column="1" OnColor="{StaticResource BrandPrimary}" ThumbColor="{StaticResource TextTertiary}" />
                    </Grid>
                    <Label x:Name="ErrorLabel" TextColor="{StaticResource Danger}" FontSize="13" IsVisible="False" />
                </VerticalStackLayout>
                <HorizontalStackLayout Grid.Row="2" Spacing="12" HorizontalOptions="End">
                    <controls:SmartButton Text="Cancel" Variant="Secondary" Clicked="OnCancelClicked" />
                    <controls:SmartButton x:Name="SaveButton" Text="Save" Variant="Primary" Clicked="OnSaveClicked" />
                </HorizontalStackLayout>
            </Grid>
        </controls:SmartCard>
    </Grid>
</ContentView>