<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:SmartBiz.Desktop.Controls"
             xmlns:vm="clr-namespace:SmartBiz.Desktop.ViewModels"
             x:Class="SmartBiz.Desktop.Views.Sales.SalesListView"
             x:DataType="vm:SalesViewModel">

    <Grid RowDefinitions="Auto,Auto,*" Padding="24" RowSpacing="12">

        <!-- Filter Bar -->
        <controls:SmartCard Grid.Row="0" Padding="24,20">
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="16">

                <Border Grid.Column="0"
                        BackgroundColor="{StaticResource SurfacePrimary}"
                        Stroke="{StaticResource BorderDefault}"
                        StrokeThickness="1"
                        Padding="12,0"
                        HeightRequest="40"
                        StrokeShape="RoundRectangle 6">
                    <Entry Placeholder="Search by invoice number or customer..."
                           Text="{Binding SearchText}"
                           ReturnCommand="{Binding SearchCommand}"
                           BackgroundColor="Transparent"
                           TextColor="{StaticResource TextPrimary}"
                           PlaceholderColor="{StaticResource TextTertiary}"
                           FontSize="14" />
                </Border>

                <VerticalStackLayout Grid.Column="1" Spacing="0">
                    <Picker x:Name="PaymentStatusPicker"
                            Title="Payment status"
                            ItemsSource="{Binding PaymentFilters}"
                            SelectedItem="{Binding PaymentFilter}"
                            WidthRequest="160"
                            FontSize="14" />
                </VerticalStackLayout>

                <controls:SmartButton Grid.Column="2"
                                      Text="+ New Sale"
                                      Variant="Primary"
                                      Clicked="OnNewSaleClicked" />
            </Grid>
        </controls:SmartCard>

        <Label Grid.Row="1"
               Text="{Binding ErrorMessage}"
               TextColor="{StaticResource Danger}"
               FontSize="13"
               IsVisible="{Binding HasError}" />

        <!-- Sales Table -->
        <controls:SmartCard Grid.Row="2" Padding="0">
            <Grid RowDefinitions="Auto,*,Auto">

                <Grid Grid.Row="0"
                      ColumnDefinitions="2*, 1.5*, 2*, 1.5*, 1.5*, 1.5*, 1.2*"
                      Padding="24,12"
                      BackgroundColor="{StaticResource BackgroundSecondary}">
                    <Label Grid.Column="0" Text="INVOICE" FontSize="11" FontAttributes="Bold" TextColor="{StaticResource TextSecondary}" />
                    <Label Grid.Column="1" Text="DATE" FontSize="11" FontAttributes="Bold" TextColor="{StaticResource TextSecondary}" />
                    <Label Grid.Column="2" Text="CUSTOMER" FontSize="11" FontAttributes="Bold" TextColor="{StaticResource TextSecondary}" />
                    <Label Grid.Column="3" Text="TOTAL" FontSize="11" FontAttributes="Bold" TextColor="{StaticResource TextSecondary}" />
                    <Label Grid.Column="4" Text="PAID" FontSize="11" FontAttributes="Bold" TextColor="{StaticResource TextSecondary}" />
                    <Label Grid.Column="5" Text="DUE" FontSize="11" FontAttributes="Bold" TextColor="{StaticResource TextSecondary}" />
                    <Label Grid.Column="6" Text="STATUS" FontSize="11" FontAttributes="Bold" TextColor="{StaticResource TextSecondary}" />
                </Grid>

                <CollectionView Grid.Row="1" ItemsSource="{Binding Sales}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="vm:SaleRow">
                            <Grid ColumnDefinitions="2*, 1.5*, 2*, 1.5*, 1.5*, 1.5*, 1.2*"
                                  Padding="24,14">
                                <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                                    <Label Text="{Binding InvoiceNumber}"
                                           FontSize="13"
                                           FontFamily="OpenSansSemibold"
                                           TextColor="{StaticResource TextPrimary}" />
                                    <Label Text="{Binding ItemCountText}"
                                           FontSize="11"
                                           TextColor="{StaticResource TextTertiary}" />
                                </VerticalStackLayout>
                                <Label Grid.Column="1" Text="{Binding DateText}" FontSize="13"
                                       TextColor="{StaticResource TextSecondary}" VerticalOptions="Center" />
                                <Label Grid.Column="2" Text="{Binding CustomerName}" FontSize="13"
                                       TextColor="{StaticResource TextPrimary}" VerticalOptions="Center"
                                       LineBreakMode="TailTruncation" />
                                <Label Grid.Column="3" Text="{Binding TotalText}" FontSize="13"
                                       FontFamily="OpenSansSemibold"
                                       TextColor="{StaticResource TextPrimary}" VerticalOptions="Center" />
                                <Label Grid.Column="4" Text="{Binding PaidText}" FontSize="13"
                                       TextColor="{StaticResource Success}" VerticalOptions="Center" />
                                <Label Grid.Column="5" Text="{Binding DueText}" FontSize="13"
                                       TextColor="{StaticResource Danger}" VerticalOptions="Center" />
                                <Label Grid.Column="6" Text="{Binding PaymentStatus}"
                                       FontSize="13"
                                       FontFamily="OpenSansSemibold"
                                       TextColor="{Binding PaymentColor}"
                                       VerticalOptions="Center" />
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>

                    <CollectionView.EmptyView>
                        <VerticalStackLayout Padding="40" Spacing="12">
                            <Label Text="💰" FontSize="48" HorizontalOptions="Center" />
                            <Label Text="No sales yet" FontSize="16" FontFamily="OpenSansSemibold"
                                   TextColor="{StaticResource TextPrimary}" HorizontalOptions="Center" />
                            <Label Text="Create your first sale to get started."
                                   FontSize="13" TextColor="{StaticResource TextSecondary}"
                                   HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </CollectionView.EmptyView>
                </CollectionView>

                <Grid Grid.Row="2"
                      ColumnDefinitions="*, Auto, Auto"
                      Padding="24,12"
                      BackgroundColor="{StaticResource BackgroundSecondary}"
                      ColumnSpacing="8">
                    <Label Grid.Column="0" Text="{Binding PageInfo}" FontSize="12"
                           TextColor="{StaticResource TextSecondary}" VerticalOptions="Center" />
                    <Button Grid.Column="1" Text="← Prev" FontSize="13" BackgroundColor="Transparent"
                            TextColor="{StaticResource BrandPrimary}" Command="{Binding PrevPageCommand}" />
                    <Button Grid.Column="2" Text="Next →" FontSize="13" BackgroundColor="Transparent"
                            TextColor="{StaticResource BrandPrimary}" Command="{Binding NextPageCommand}" />
                </Grid>
            </Grid>
        </controls:SmartCard>

    </Grid>

</ContentView>