<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="SmartBiz.Desktop.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:SmartBiz.Desktop.Controls">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="24">

            <controls:SmartCard Padding="40">
                <VerticalStackLayout Spacing="12" HorizontalOptions="Center">
                    <Label Text="🎉" FontSize="48" HorizontalOptions="Center" />
                    <Label
                        Text="You're signed in!"
                        FontSize="22"
                        FontFamily="OpenSansSemibold"
                        HorizontalOptions="Center" />
                    <Label
                        Text="The dashboard will show sales, purchases, and metrics here."
                        FontSize="14"
                        TextColor="{StaticResource TextSecondary}"
                        HorizontalTextAlignment="Center"
                        HorizontalOptions="Center" />
                </VerticalStackLayout>
            </controls:SmartCard>

        </VerticalStackLayout>
    </ScrollView>

</ContentView>