<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:SmartBiz.Desktop.Controls"
             x:Class="SmartBiz.Desktop.Views.Brands.BrandFormView">

    <Grid>
        <controls:SmartCard Padding="0"
                            WidthRequest="560"
                            HorizontalOptions="Center"
                            VerticalOptions="Center">
            <Grid RowDefinitions="Auto,*,Auto">

                <Grid Grid.Row="0" Padding="32,24,32,16">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Add Brand"
                               FontSize="22"
                               FontFamily="OpenSansSemibold"
                               TextColor="{StaticResource TextPrimary}" />
                        <Label Text="Add a new product brand"
                               FontSize="13"
                               TextColor="{StaticResource TextSecondary}" />
                    </VerticalStackLayout>
                </Grid>

                <BoxView Grid.Row="0" HeightRequest="1"
                         Color="{StaticResource BorderDefault}"
                         VerticalOptions="End" />

                <ScrollView Grid.Row="1">
                    <VerticalStackLayout Padding="32,24" Spacing="16">
                        <controls:SmartTextBox x:Name="NameField"
                            Label="Name *" Placeholder="Samsung" />

                        <controls:SmartTextBox x:Name="DescriptionField"
                            Label="Description" Placeholder="Short description" />

                        <Label x:Name="ErrorLabel"
                               TextColor="{StaticResource Danger}"
                               FontSize="13"
                               IsVisible="False" />
                    </VerticalStackLayout>
                </ScrollView>

                <BoxView Grid.Row="1" HeightRequest="1"
                         Color="{StaticResource BorderDefault}"
                         VerticalOptions="End" />

                <HorizontalStackLayout Grid.Row="2"
                                       Padding="32,20"
                                       Spacing="12"
                                       HorizontalOptions="End">
                    <controls:SmartButton Text="Cancel" Variant="Secondary" Clicked="OnCancelClicked" />
                    <controls:SmartButton x:Name="SaveButton" Text="Save Brand" Variant="Primary" Clicked="OnSaveClicked" />
                </HorizontalStackLayout>

            </Grid>
        </controls:SmartCard>
    </Grid>

</ContentView>