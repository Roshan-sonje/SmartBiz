<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:SmartBiz.Desktop.Controls"
             x:Class="SmartBiz.Desktop.Views.Customers.CustomerFormView">

    <Grid>
        <controls:SmartCard Padding="0"
                            WidthRequest="720"
                            HorizontalOptions="Center"
                            VerticalOptions="Center"
                            MaximumHeightRequest="800">
            <Grid RowDefinitions="Auto,*,Auto">

                <!-- HEADER -->
                <Grid Grid.Row="0" Padding="32,24,32,16">
                    <VerticalStackLayout Spacing="4">
                        <Label x:Name="DialogTitle" Text="Add Customer"
                               FontSize="22"
                               FontFamily="OpenSansSemibold"
                               TextColor="{StaticResource TextPrimary}" />
                        <Label Text="Fill in the customer details below"
                               FontSize="13"
                               TextColor="{StaticResource TextSecondary}" />
                    </VerticalStackLayout>
                </Grid>

                <BoxView Grid.Row="0" HeightRequest="1"
                         Color="{StaticResource BorderDefault}"
                         VerticalOptions="End" />

                <!-- BODY -->
                <ScrollView Grid.Row="1">
                    <VerticalStackLayout Padding="32,24" Spacing="24">

                        <VerticalStackLayout Spacing="14">
                            <Label Text="Contact"
                                   FontSize="15"
                                   FontFamily="OpenSansSemibold"
                                   TextColor="{StaticResource TextPrimary}" />

                            <controls:SmartTextBox x:Name="NameField"
                                Label="Name *" Placeholder="Customer name" />

                            <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                                <controls:SmartTextBox x:Name="PhoneField" Grid.Column="0"
                                    Label="Phone" Placeholder="9876543210" />
                                <controls:SmartTextBox x:Name="EmailField" Grid.Column="1"
                                    Label="Email" Placeholder="customer@example.com" />
                            </Grid>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="14">
                            <Label Text="Address"
                                   FontSize="15"
                                   FontFamily="OpenSansSemibold"
                                   TextColor="{StaticResource TextPrimary}" />

                            <controls:SmartTextBox x:Name="AddressField"
                                Label="Street address" Placeholder="123 Main Street" />

                            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="16">
                                <controls:SmartTextBox x:Name="CityField" Grid.Column="0"
                                    Label="City" Placeholder="Mumbai" />
                                <controls:SmartTextBox x:Name="StateField" Grid.Column="1"
                                    Label="State" Placeholder="Maharashtra" />
                                <controls:SmartTextBox x:Name="PostalField" Grid.Column="2"
                                    Label="Postal code" Placeholder="400001" />
                            </Grid>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="14">
                            <Label Text="Business Details"
                                   FontSize="15"
                                   FontFamily="OpenSansSemibold"
                                   TextColor="{StaticResource TextPrimary}" />

                            <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                                <controls:SmartTextBox x:Name="GstinField" Grid.Column="0"
                                    Label="GSTIN" Placeholder="27ABCDE1234F1Z5" />
                                <controls:SmartTextBox x:Name="BalanceField" Grid.Column="1"
                                    Label="Opening balance" Placeholder="0.00" />
                            </Grid>

                            <controls:SmartTextBox x:Name="CreditLimitField"
                                Label="Credit limit" Placeholder="50000" />
                        </VerticalStackLayout>

                        <Label x:Name="ErrorLabel"
                               TextColor="{StaticResource Danger}"
                               FontSize="13"
                               IsVisible="False" />

                    </VerticalStackLayout>
                </ScrollView>

                <BoxView Grid.Row="1" HeightRequest="1"
                         Color="{StaticResource BorderDefault}"
                         VerticalOptions="End" />

                <!-- FOOTER -->
                <HorizontalStackLayout Grid.Row="2"
                                       Padding="32,20"
                                       Spacing="12"
                                       HorizontalOptions="End">
                    <controls:SmartButton Text="Cancel" Variant="Secondary" Clicked="OnCancelClicked" />
                    <controls:SmartButton x:Name="SaveButton" Text="Save Customer" Variant="Primary" Clicked="OnSaveClicked" />
                </HorizontalStackLayout>

            </Grid>
        </controls:SmartCard>
    </Grid>

</ContentView>