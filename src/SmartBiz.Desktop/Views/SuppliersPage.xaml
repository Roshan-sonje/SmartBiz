<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="SmartBiz.Desktop.Views.SuppliersPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:SmartBiz.Desktop.Controls"
    xmlns:vm="clr-namespace:SmartBiz.Desktop.ViewModels"
    x:DataType="vm:SuppliersViewModel">

    <Grid RowDefinitions="Auto, Auto, *" Padding="24" RowSpacing="12">

        <controls:SmartCard Grid.Row="0" Padding="24,20">
            <Grid ColumnDefinitions="*, Auto" ColumnSpacing="16">
                <Border Grid.Column="0"
                        BackgroundColor="{StaticResource SurfacePrimary}"
                        Stroke="{StaticResource BorderDefault}"
                        StrokeThickness="1"
                        Padding="12,0"
                        HeightRequest="40"
                        StrokeShape="RoundRectangle 6">
                    <Entry Placeholder="Search suppliers by name, phone, or email..."
                           Text="{Binding SearchText}"
                           ReturnCommand="{Binding SearchCommand}"
                           BackgroundColor="Transparent"
                           FontSize="14" />
                </Border>

                <controls:SmartButton Grid.Column="1"
                                      Text="+ Add Supplier"
                                      Variant="Primary"
                                      Clicked="OnAddClicked" />
            </Grid>
        </controls:SmartCard>

        <Label Grid.Row="1"
               Text="{Binding ErrorMessage}"
               TextColor="{StaticResource Danger}"
               FontSize="13"
               IsVisible="{Binding HasError}" />

        <controls:SmartCard Grid.Row="2" Padding="0">
            <Grid RowDefinitions="Auto, *, Auto">

                <Grid Grid.Row="0"
                      ColumnDefinitions="2*, 1.5*, 2*, 1.5*, 1.5*, Auto"
                      Padding="24,12"
                      BackgroundColor="{StaticResource BackgroundSecondary}">
                    <Label Grid.Column="0" Text="NAME" FontSize="11" FontAttributes="Bold" TextColor="{StaticResource TextSecondary}" />
                    <Label Grid.Column="1" Text="PHONE" FontSize="11" FontAttributes="Bold" TextColor="{StaticResource TextSecondary}" />
                    <Label Grid.Column="2" Text="EMAIL" FontSize="11" FontAttributes="Bold" TextColor="{StaticResource TextSecondary}" />
                    <Label Grid.Column="3" Text="CITY" FontSize="11" FontAttributes="Bold" TextColor="{StaticResource TextSecondary}" />
                    <Label Grid.Column="4" Text="BALANCE" FontSize="11" FontAttributes="Bold" TextColor="{StaticResource TextSecondary}" />
                    <Label Grid.Column="5" Text="" />
                </Grid>

                <CollectionView Grid.Row="1"
                                ItemsSource="{Binding Suppliers}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="vm:SupplierRow">
                            <Grid ColumnDefinitions="2*, 1.5*, 2*, 1.5*, 1.5*, Auto"
                                  Padding="24,14">
                                <Label Grid.Column="0"
                                       Text="{Binding Name}"
                                       FontSize="14"
                                       FontFamily="OpenSansSemibold"
                                       TextColor="{StaticResource TextPrimary}"
                                       VerticalOptions="Center" />
                                <Label Grid.Column="1"
                                       Text="{Binding Phone}"
                                       FontSize="13"
                                       TextColor="{StaticResource TextSecondary}"
                                       VerticalOptions="Center" />
                                <Label Grid.Column="2"
                                       Text="{Binding Email}"
                                       FontSize="13"
                                       TextColor="{StaticResource TextSecondary}"
                                       VerticalOptions="Center"
                                       LineBreakMode="TailTruncation" />
                                <Label Grid.Column="3"
                                       Text="{Binding City}"
                                       FontSize="13"
                                       TextColor="{StaticResource TextSecondary}"
                                       VerticalOptions="Center" />
                                <Label Grid.Column="4"
                                       Text="{Binding BalanceText}"
                                       FontSize="13"
                                       TextColor="{StaticResource TextPrimary}"
                                       VerticalOptions="Center" />
                                <Button Grid.Column="5"
                                        Text="🗑"
                                        FontSize="14"
                                        BackgroundColor="Transparent"
                                        Padding="8"
                                        Clicked="OnDeleteClicked"
                                        CommandParameter="{Binding .}" />
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>

                    <CollectionView.EmptyView>
                        <VerticalStackLayout Padding="40" Spacing="12">
                            <Label Text="🏭" FontSize="48" HorizontalOptions="Center" />
                            <Label Text="No suppliers yet"
                                   FontSize="16"
                                   FontFamily="OpenSansSemibold"
                                   HorizontalOptions="Center" />
                            <Label Text="Add your first supplier to get started."
                                   FontSize="13"
                                   TextColor="{StaticResource TextSecondary}"
                                   HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </CollectionView.EmptyView>
                </CollectionView>

                <Grid Grid.Row="2"
                      ColumnDefinitions="*, Auto, Auto"
                      Padding="24,12"
                      BackgroundColor="{StaticResource BackgroundSecondary}"
                      ColumnSpacing="8">
                    <Label Grid.Column="0"
                           Text="{Binding PageInfo}"
                           FontSize="12"
                           TextColor="{StaticResource TextSecondary}"
                           VerticalOptions="Center" />
                    <Button Grid.Column="1"
                            Text="← Prev"
                            FontSize="13"
                            BackgroundColor="Transparent"
                            TextColor="{StaticResource BrandPrimary}"
                            Command="{Binding PrevPageCommand}" />
                    <Button Grid.Column="2"
                            Text="Next →"
                            FontSize="13"
                            BackgroundColor="Transparent"
                            TextColor="{StaticResource BrandPrimary}"
                            Command="{Binding NextPageCommand}" />
                </Grid>

            </Grid>
        </controls:SmartCard>

    </Grid>

</ContentView>